# 이 파일을 .env 로 복사해서 쓴다. .env 는 커밋하지 않는다(.gitignore).
#
#   copy .env.example .env
#
# 주석은 # 로 시작하는 줄만 인식한다(줄 끝 주석은 값의 일부가 된다).
# 값에 따옴표를 씌우지 말 것 — 따옴표까지 값으로 들어간다.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=

# mysql.exe 경로. DROP/CREATE DATABASE 에만 쓴다(liquibase 는 PATH 에서 찾는다).
MYSQL_EXE=C:\Program Files\MySQL\MySQL Server 8.0\bin\mysql.exe
